# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force source and configuration files to use LF line endings
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Treat binary files appropriately
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
