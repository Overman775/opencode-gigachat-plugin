{
  "name": "opencode-gigachat-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "GigaCode / GigaChat API integration plugin for the OpenCode AI coding assistant",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:release": "npm run build && node scripts/build-release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "watch": "tsc -w",
    "test": "vitest run",
    "encode-creds": "node bin/encode-credentials.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^5.2.2",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "opencode",
    "gigacode",
    "gigachat",
    "plugin",
    "auth"
  ],
  "author": "Antigravity SDD Orchestrator",
  "license": "MIT"
}
