{
  "name": "opencode-gigachat-plugin",
  "version": "1.0.2",
  "private": true,
  "description": "GigaCode / GigaChat API integration plugin for the OpenCode AI coding assistant",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:release": "npm run build && node scripts/build-release.mjs",
    "build:release:v2": "npm run build && node scripts/build-release-v2.mjs",
    "test:release": "node scripts/test-release.mjs",
    "test:release:v2": "node scripts/test-release-v2.mjs",
    "watch": "tsc -w",
    "test": "vitest run",
    "encode-creds": "node bin/encode-credentials.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@opencode/plugin": "^2.0.32",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@opencode-ai/plugin": {
      "effect": "4.0.1",
      "zod": "4.6.7"
    }
  },
  "keywords": [
    "opencode",
    "gigacode",
    "gigachat",
    "plugin",
    "auth"
  ],
  "author": "Antigravity SDD Orchestrator",
  "license": "MIT"
}
